#!/bin/bash
set -euo pipefail

# -----------------------------------------------------------------------------
# globals
# -----------------------------------------------------------------------------
REPO_URL=https://github.com/emrahcom/my-claude-vm-trixie.git
REPO_DIR=/tmp/my-claude-vm-trixie
TMPL=$REPO_DIR/templates
USER_NAME=emrah


# -----------------------------------------------------------------------------
# output format
# -----------------------------------------------------------------------------
out() {
    printf "\n"

    while IFS= read -r line; do
        printf "\033[0;31m>>>\033[0m \033[0;33m%s\033[0m\n" "$line"
    done
}


# -----------------------------------------------------------------------------
# apt
# -----------------------------------------------------------------------------
apt-get-norec() {
    apt-get -y --no-install-recommends "$@"
}

apt-get-rec() {
    apt-get -y --install-recommends "$@"
}


# -----------------------------------------------------------------------------
# trap on exit
# -----------------------------------------------------------------------------
function on_exit {
    if [[ "$COMPLETED" != true ]]; then
        out <<< "Something went wrong. Not completed!"
        exit 1
    else
        out <<EOF
Installation Duration: $DURATION
Completed successfully!
EOF
        exit 0
    fi
}

COMPLETED=false
trap on_exit EXIT


# -----------------------------------------------------------------------------
# environment
# -----------------------------------------------------------------------------
export DEBIAN_FRONTEND=noninteractive
START_TIME=$(date +%s)


# -----------------------------------------------------------------------------
# environment check
# -----------------------------------------------------------------------------
# root
out <<< "checking the user account..."
if [[ "$EUID" -ne 0 ]]; then
    out <<EOF
Aborted! You are not the root user
Recommendation: Use the following command to be the 'root' user

    su -l
EOF
    exit 1
fi

# distro
out <<< "checking the distro..."
DISTRO=$(grep VERSION_CODENAME /etc/os-release | cut -d= -f2)

if [[ "$DISTRO" != "trixie" ]]; then
    out <<EOF
Aborted! Your distro is not supported: $DISTRO
Recommendation: Use Debian 13 Trixie
EOF
    exit 1
fi

# are you sure
out <<EOF
This script installs or updates the Claude Code work environment.
Use it only on a Debian 13 Trixie VM, not on your desktop machine.
If you are sure then write YES (uppercase) and press enter to start!
EOF

read -r answer
if [[ "$answer" != "YES" ]]; then
    out <<EOF
Aborted! not approved, typed: $answer
EOF
    exit 1
fi


# -----------------------------------------------------------------------------
# packages (base)
# -----------------------------------------------------------------------------
out <<< "upgrading the system..."

apt-get update
apt-get -y dist-upgrade
apt-get -y autoremove --purge
apt-get autoclean

out <<< "installing the base packages..."

apt-get-norec install zsh tmux vim autojump fzf
apt-get-norec install git gnupg ca-certificates curl wget unzip
apt-get-norec install ripgrep ack jq tree htop net-tools
apt-get-norec install build-essential
apt-get-norec install glab


# -----------------------------------------------------------------------------
# repo
# -----------------------------------------------------------------------------
out <<< "cloning the repo..."

rm -rf "$REPO_DIR"
git clone --depth 1 "$REPO_URL" "$REPO_DIR"


# -----------------------------------------------------------------------------
# user
# -----------------------------------------------------------------------------
out <<< "creating the user $USER_NAME if not exists..."

if ! id "$USER_NAME" &>/dev/null; then
    adduser --disabled-password --comment "" --shell /bin/zsh "$USER_NAME"
fi


# -----------------------------------------------------------------------------
# docker
# -----------------------------------------------------------------------------
out <<< "installing docker..."

mkdir -p /etc/apt/keyrings
wget -T 10 -qO /etc/apt/keyrings/docker.asc \
    https://download.docker.com/linux/debian/gpg
cp "$TMPL/etc/apt/sources.list.d/docker.sources" /etc/apt/sources.list.d/

apt-get update
apt-get-norec install docker-ce docker-ce-cli containerd.io \
    docker-buildx-plugin docker-compose-plugin

usermod -aG docker "$USER_NAME"


# -----------------------------------------------------------------------------
# node & yarn
# -----------------------------------------------------------------------------
out <<< "installing node and yarn..."

wget -T 10 -qO /etc/apt/keyrings/nodesource.asc \
    https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key
cp "$TMPL/etc/apt/sources.list.d/nodesource.sources" /etc/apt/sources.list.d/

wget -T 10 -qO /etc/apt/keyrings/yarn.asc \
    https://dl.yarnpkg.com/debian/pubkey.gpg
cp "$TMPL/etc/apt/sources.list.d/yarn.sources" /etc/apt/sources.list.d/

apt-get update
apt-get-norec install nodejs yarn


# -----------------------------------------------------------------------------
# claude code
# -----------------------------------------------------------------------------
out <<< "installing claude code if not exists..."

if [[ ! -x "/home/$USER_NAME/.local/bin/claude" ]]; then
    su -l "$USER_NAME" -s /bin/bash -c \
        "set -o pipefail; curl -fsSL https://claude.ai/install.sh | bash"
fi


# -----------------------------------------------------------------------------
# claude config
# -----------------------------------------------------------------------------
out <<< "adding claude config if not exists..."

su -l "$USER_NAME" -s /bin/bash -c "
    set -e
    mkdir -p ~/.claude
    cp --update=none $TMPL/home/user/.claude/settings.json ~/.claude/
    cp --update=none $TMPL/home/user/.claude/CLAUDE.md ~/.claude/
"


# -----------------------------------------------------------------------------
# dotfiles
# -----------------------------------------------------------------------------
out <<< "adding dotfiles if not exists..."

su -l "$USER_NAME" -s /bin/bash -c "
    set -e
    cp --update=none $TMPL/home/user/.zshrc ~/
    cp --update=none $TMPL/home/user/.vimrc ~/
    cp --update=none $TMPL/home/user/.tmux.conf ~/
"


# -----------------------------------------------------------------------------
# completed
# -----------------------------------------------------------------------------
END_TIME=$(date +%s)
DURATION=$(date -u -d "0 $END_TIME seconds - $START_TIME seconds" +"%H:%M:%S")
COMPLETED=true
